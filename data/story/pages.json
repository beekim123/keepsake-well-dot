            "art": "big.douding",
            "x": 72,
            "y": 64
          },
          {
            "art": "keepsake.mianmian_large",
            "x": 105,
            "y": 96
          },
          {
            "art": "big.mai_aunt",
            "x": 174,
            "y": 56
