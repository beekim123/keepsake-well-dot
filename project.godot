; Engine configuration file. Edit source assets outside godot/resources and godot/data.
config_version=5

[application]
config/name="拾遗井"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="D2 presentation work in progress; accepted core loop, final visual and export acceptance pending."

[autoload]
AssetCatalog="*res://scripts/services/asset_catalog.gd"
AudioService="*res://scripts/services/audio_service.gd"
SaveService="*res://scripts/services/save_service.gd"
ContentCatalog="*res://scripts/content/content_catalog.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[importer_defaults]

wav={
"compress/mode": 0,
"edit/normalize": false,
"edit/trim": false,
"force/8_bit": false,
"force/max_rate": false,
"force/mono": false
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.106, 0.086, 0.133, 1)
